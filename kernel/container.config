##
## container.config - Kconfig fragment for running Docker and K3s on riscv64
##
## Merge on top of a base config, for example:
##   ARCH=riscv scripts/kconfig/merge_config.sh -m arch/riscv/configs/defconfig container.config
##   make ARCH=riscv olddefconfig
##
## Everything is =y on purpose: the target rootfs is an initrd that does not
## load modules, so nothing here may end up as =m.
##
## Tags used below:
##   [docker]  listed under "Generally Necessary" by moby contrib/check-config.sh
##   [k3s]     listed under "Generally Necessary" by k3s contrib/util/check-config.sh
##   [runc]    needed by runc/crun on cgroup v2 even though no script checks it
##   [rec]     recommended or optional in one of the scripts, or used by a common
##             K3s component (kube-proxy, flannel, kube-router network policy)
##   [boot]    needed by this particular setup (initrd rootfs, no modules)
##
## Tested against Linux 7.2.6. In 7.x the legacy iptables tables (IP_NF_FILTER,
## IP_NF_NAT, IP_NF_MANGLE, IP_NF_RAW and the IPv6 equivalents) only exist when
## NETFILTER_XTABLES_LEGACY and IP{,6}_NF_IPTABLES_LEGACY are set, so those
## switches are enabled below. Without them merge_config silently drops the
## tables that both check scripts look for.
##

## ---------------------------------------------------------------------------
## Boot: initrd rootfs, no module loading, config readable at runtime
## ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
# [boot] the initrd is a gzip-compressed cpio archive
CONFIG_RD_GZIP=y
# [boot] /dev populated by the kernel before /init runs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# [k3s] k3s check-config reads /proc/config.gz at runtime
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## ---------------------------------------------------------------------------
## Namespaces
## ---------------------------------------------------------------------------
# [docker][k3s]
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# [rec] optional in both scripts; needed for rootless and userns-remap
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
# [runc] cgroup namespaces have no Kconfig symbol in 7.x: kernel/cgroup/Makefile
# builds namespace.o unconditionally whenever CGROUPS=y.

## ---------------------------------------------------------------------------
## cgroups (the target is cgroup v2 only)
## ---------------------------------------------------------------------------
# [docker][k3s] memory controller
CONFIG_MEMCG=y
# [docker][k3s] pids controller (optional in moby, required in k3s)
CONFIG_CGROUP_PIDS=y
# [docker][k3s] cpuset controller
CONFIG_CPUSETS=y
# [docker][k3s] cpu controller, with CFS quota for container CPU limits
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# [docker][k3s] checked by both scripts. On cgroup v2 cpuacct is folded
# into the cpu controller, but the scripts still grep for the symbol.
CONFIG_CGROUP_CPUACCT=y
# [docker][k3s] checked by both scripts. On cgroup v2 device access is
# enforced with eBPF (CGROUP_BPF below); this symbol is the v1 controller.
CONFIG_CGROUP_DEVICE=y
# [docker][k3s] checked by both scripts. The v2 freezer (cgroup.freeze) is
# built into cgroup v2 core; this symbol is the v1 controller.
CONFIG_CGROUP_FREEZER=y
# [runc][docker] runc attaches an eBPF program to implement the device
# controller on cgroup v2. Without these, containers fail to start on v2.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# [rec] JIT for the eBPF device filter (riscv64 has an eBPF JIT)
CONFIG_BPF_JIT=y
# [rec] io controller and I/O throttling
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
# [rec] perf_event controller
CONFIG_CGROUP_PERF=y
# [rec] hugetlb controller (needs hugetlbfs)
CONFIG_HUGETLBFS=y
CONFIG_CGROUP_HUGETLB=y
# [rec] net_cls / net_prio (v1 only, but checked as optional by both scripts)
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
# RT_GROUP_SCHED is listed as optional by k3s check-config and is left out on
# purpose: on cgroup v2 it prevents enabling the cpu controller while any
# SCHED_FIFO/RR task sits outside the root cgroup.

## ---------------------------------------------------------------------------
## Filesystems and IPC
## ---------------------------------------------------------------------------
# [docker][k3s] image layers (overlay2 / containerd overlayfs snapshotter)
CONFIG_OVERLAY_FS=y
# [boot] the initrd rootfs is tmpfs. overlayfs stores its metadata in
# trusted.* xattrs, so the tmpfs upper/work dirs must support xattrs.
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
# [docker][k3s] mqueue, bind-mounted into containers
CONFIG_POSIX_MQUEUE=y
# [docker][k3s] session keyrings (runc creates one per container)
CONFIG_KEYS=y
# [rec] seccomp profiles (SECCOMP is required by k3s, optional in moby)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# [rec] both scripts check ext4; harmless, and useful if a disk appears later
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

## ---------------------------------------------------------------------------
## Network devices
## ---------------------------------------------------------------------------
# [docker][k3s] container veth pairs and the docker0 / cni0 bridge
CONFIG_VETH=y
CONFIG_BRIDGE=y
# [docker][k3s] br_netfilter: flannel and kube-proxy need bridged traffic to
# traverse iptables (net.bridge.bridge-nf-call-iptables)
CONFIG_BRIDGE_NETFILTER=y
# [rec] moby overlay network driver
CONFIG_BRIDGE_VLAN_FILTERING=y
# [rec] flannel VXLAN backend (the K3s default) and moby overlay networks
CONFIG_VXLAN=y
# [rec] a dummy interface can carry the default route K3s wants when the
# guest has no real NIC
CONFIG_DUMMY=y
# [rec] moby macvlan/ipvlan network drivers
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y

## ---------------------------------------------------------------------------
## Netfilter core and conntrack
## ---------------------------------------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
# [docker][k3s]
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
# [rec] conntrack netlink, used by kube-proxy to flush stale UDP entries
CONFIG_NF_CT_NETLINK=y
# [rec] moby "ftp,tftp client in container"
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_TFTP=y
CONFIG_NETFILTER_XTABLES=y

## ---------------------------------------------------------------------------
## xtables matches and targets (shared by iptables-legacy and iptables-nft)
## ---------------------------------------------------------------------------
# [docker][k3s]
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MARK=y
# [k3s] kube-proxy
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
# [rec] kube-proxy session affinity, kube-router network policy, misc
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_SET=y

## ---------------------------------------------------------------------------
## IPv4 / IPv6 iptables tables (legacy xtables backend)
## ---------------------------------------------------------------------------
# Gate for all legacy tables since the xtables-legacy split
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
# [docker][k3s]
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
# [k3s]
CONFIG_IP_NF_TARGET_REJECT=y
# [docker]
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
# [rec]
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
# [docker]
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# [rec]
CONFIG_IP6_NF_TARGET_REJECT=y

## ---------------------------------------------------------------------------
## nftables (iptables-nft backend, and kube-proxy nftables mode)
## ---------------------------------------------------------------------------
# [rec] moby lists these as optional; iptables-nft needs them to work at all
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
# [rec] iptables-nft translates xt matches through nft_compat
CONFIG_NFT_COMPAT=y
# [rec] used by kube-proxy in nftables mode
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y

## ---------------------------------------------------------------------------
## IP sets and IPVS
## ---------------------------------------------------------------------------
# [rec] kube-router network policy controller (bundled in K3s) uses ipset
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_LIST_SET=y
# [rec] optional in both scripts (kube-proxy IPVS mode)
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y

## ---------------------------------------------------------------------------
## Encrypted overlay networks (optional in both scripts)
## ---------------------------------------------------------------------------
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_SEQIV=y
# CRYPTO_GHASH no longer exists in 7.x. GHASH lives in CRYPTO_LIB_GF128HASH,
# which CRYPTO_GCM selects. Both check scripts still grep for the old name and
# will report it missing; that line is cosmetic.
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y

#
# Console for a Xen dom0less domU (not needed on QEMU virt, harmless there)
#
# Xen's virtual SBI for guests implements only the legacy console calls
# (xen/arch/riscv/vsbi/legacy-extension.c handles SBI_EXT_0_1_CONSOLE_PUTCHAR
# and GETCHAR). It has no SBI_EXT_DBCN handler.
#
# Linux drives the SBI console two ways, and without RISCV_SBI_V01 both fail
# on Xen: earlycon-riscv-sbi.c falls back to sbi_console_putchar() when DBCN
# is unavailable, and that function is compiled only under CONFIG_RISCV_SBI_V01
# (arch/riscv/kernel/sbi.c; asm/sbi.h otherwise defines it as an empty stub).
# HVC_RISCV_SBI is not an answer either: it calls sbi_debug_console_write(),
# so it needs DBCN, and it also depends on NONPORTABLE.
#
# A guest given a passthrough UART does not need this, but enabling it costs
# nothing and turns a silent domU into a debuggable one.
CONFIG_RISCV_SBI_V01=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
